<Window x:Class="FluentTlsTunnel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fluent TLS Tunnel">
 <Grid x:Name="Root" Padding="28" RowSpacing="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="6"><TextBlock Text="Fluent TLS Tunnel" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>

  </Grid>
  <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="LeftCompact" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="NavChanged">
<NavigationView.MenuItems><NavigationViewItem x:Name="ConnectionNav" Tag="connection" Content="Connection"><NavigationViewItem.Icon><SymbolIcon Symbol="Link"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="SettingsNav" Tag="settings" Content="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="AboutNav" Tag="about" Content="About"><NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems><Grid Padding="12,0"><ScrollViewer x:Name="ConnectionPage" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12"><Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon x:Name="StatusGlyph" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="HeroTitle" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="HeroDetail" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock x:Name="ConnectionTime" Grid.Column="2" Text="00:00:00" Visibility="Collapsed" VerticalAlignment="Center" FlowDirection="LeftToRight" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Border>
   <InfoBar x:Name="Status" IsOpen="False" IsClosable="False" Severity="Informational"/>
   <Expander x:Name="ProfilePanel" HorizontalAlignment="Stretch" IsExpanded="True">
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
    <StackPanel Spacing="14">
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="Import" Click="ImportClick"/><Button x:Name="Export" Click="ExportClick"/></StackPanel>
     <TextBlock x:Name="ConnectionTitle" FontSize="18" FontWeight="SemiBold"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="Host" FlowDirection="LeftToRight"/><NumberBox x:Name="Port" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" FlowDirection="LeftToRight"/></Grid>
     <TextBox x:Name="Sni" FlowDirection="LeftToRight"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="Username" FlowDirection="LeftToRight"/><PasswordBox x:Name="Password" Grid.Column="1" FlowDirection="LeftToRight"/></Grid>
     <CheckBox x:Name="VerifyTls" IsChecked="True"/>
     <TextBlock x:Name="TlsHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </Border>
   </Expander>

   <Expander x:Name="LogsPanel" HorizontalAlignment="Stretch"><TextBox x:Name="Logs" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" FlowDirection="LeftToRight" FontFamily="Cascadia Mono"/></Expander>
   <TextBlock x:Name="Credits" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="Mohamed Elnaggar · "/><Hyperlink NavigateUri="https://instinct.com">brought to you by Instinct</Hyperlink></TextBlock>
  </StackPanel></ScrollViewer><ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="20" Padding="0,12">   <StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="Language" Width="130" SelectionChanged="SettingsChanged"><ComboBoxItem Content="System" Tag="system"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="العربية" Tag="ar"/></ComboBox><ComboBox x:Name="Theme" Width="110" SelectionChanged="SettingsChanged"><ComboBoxItem Content="System" Tag="system"/><ComboBoxItem Content="Light" Tag="light"/><ComboBoxItem Content="Dark" Tag="dark"/></ComboBox></StackPanel>
   <Expander x:Name="AdvancedPanel" HorizontalAlignment="Stretch">
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
    <StackPanel Spacing="12">
     <TextBlock x:Name="RoutingTitle" FontSize="18" FontWeight="SemiBold"/>
     <NumberBox x:Name="SocksPort" Minimum="1024" Maximum="65535" Value="1080" SpinButtonPlacementMode="Compact" FlowDirection="LeftToRight"/>
     <TextBlock x:Name="ProxyHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <CheckBox x:Name="UseDns"/>
     <ComboBox x:Name="Adapter" HorizontalAlignment="Stretch"/>
     <TextBox x:Name="Dns" PlaceholderText="1.1.1.1, 1.0.0.1" FlowDirection="LeftToRight"/>
     <TextBlock x:Name="DnsHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Button x:Name="RestoreDns" Click="RestoreDnsClick"/>
    </StackPanel>
   </Border>
   </Expander>
</StackPanel></ScrollViewer><ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Padding="20" HorizontalAlignment="Center" MaxWidth="520">

<Image Source="ms-appx:///3-AppIcon.png" Width="128" Height="128"/>
<TextBlock Text="Fluent TLS Tunnel" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
<TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<TextBlock x:Name="AboutDescription" TextWrapping="Wrap" TextAlignment="Center"/>
<Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8">
<TextBlock x:Name="DeveloperCredit" HorizontalAlignment="Center" FontWeight="SemiBold"/>
<HyperlinkButton Content="brought to you by Instinct" NavigateUri="https://instinct.com" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
<HyperlinkButton x:Name="RepositoryLink" NavigateUri="https://github.com/MohamedElnaggar00/fluent-tls-tunnel" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
<TextBlock Text="MIT License" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
</StackPanel></Border></StackPanel></ScrollViewer></Grid></NavigationView>
  <Grid x:Name="ConnectionActions" Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="ConnectClick"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:Name="ConnectIcon" Symbol="Link"/><TextBlock x:Name="ConnectLabel" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="Save" Grid.Column="1" Click="SaveClick"/></Grid>
 </Grid>
</Window>
